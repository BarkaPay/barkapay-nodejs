{
  "name": "barkapay-payhub",
  "version": "1.1.0",
  "description": "Official Node.js / TypeScript SDK for the barkapay payments API — mobile money collections, payouts and payment links across West Africa.",
  "license": "MIT",
  "author": "barkapay",
  "homepage": "https://payhub.africa/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BarkaPay/payhub-nodejs.git"
  },
  "bugs": {
    "url": "https://github.com/BarkaPay/payhub-nodejs/issues"
  },
  "keywords": [
    "barkapay",
    "payhub",
    "payments",
    "mobile money",
    "payment links",
    "orange money",
    "moov",
    "mtn",
    "wave",
    "west africa",
    "burkina faso",
    "benin",
    "senegal",
    "api",
    "sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node smoke/esm.mjs && node smoke/cjs.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test && npm run build && npm run test:smoke",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "esbuild": "^0.28.1"
  }
}
