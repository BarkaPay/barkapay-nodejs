{
  "name": "barkapay-payhub",
  "version": "1.0.0",
  "description": "Official Node.js / TypeScript SDK for the PayHub payments API — mobile money & crypto, one API across countries.",
  "license": "MIT",
  "author": "BarkaPay (PayHub)",
  "homepage": "https://payhub.africa/developers",
  "repository": {
    "type": "git",
    "url": "https://github.com/BarkaPay/payhub-nodejs.git"
  },
  "bugs": {
    "url": "https://github.com/BarkaPay/payhub-nodejs/issues"
  },
  "keywords": [
    "payhub",
    "barkapay",
    "payments",
    "mobile money",
    "mtn",
    "orange",
    "moov",
    "wave",
    "west africa",
    "api",
    "sdk"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
